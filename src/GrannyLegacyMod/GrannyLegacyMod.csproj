<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>GrannyLegacyMod</AssemblyName>
    <RootNamespace>GrannyLegacyMod</RootNamespace>
    <Version>0.9.4</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1603;CA1416</NoWarn>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <!-- Path to your Granny Legacy install. Override with: dotnet build -p:GameDir="D:\Games\Granny Legacy" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Granny Legacy</GameDir>
    <InteropDir>$(GameDir)\BepInEx\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.789" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
  </ItemGroup>

  <!-- Game + Unity interop assemblies. These are generated by BepInEx on your PC the first time
       the game runs with BepInEx installed, so they are only referenced when they exist. -->
  <ItemGroup Condition="Exists('$(InteropDir)')">
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <!-- The ImGui overlay (native/GrannyOverlay). Build it first with build.sh or CMake. -->
  <PropertyGroup>
    <OverlayDll>$(MSBuildThisFileDirectory)..\..\native\GrannyOverlay\build\GrannyOverlay.dll</OverlayDll>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(OverlayDll)')">
    <None Include="$(OverlayDll)" Link="GrannyOverlay.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy the built mod straight into the game's plugins folder when the game is installed. -->
  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)" />
    <Copy SourceFiles="$(OverlayDll)" DestinationFolder="$(GameDir)\BepInEx\plugins\$(AssemblyName)" Condition="Exists('$(OverlayDll)')" />
  </Target>

</Project>
